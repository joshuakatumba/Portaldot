# ─────────────────────────────────────────────
# GhostFund — Polkadot Ecosystem Configuration
# ─────────────────────────────────────────────

# Deployer private key (EVM-compatible, used for both Westend Asset Hub and Sepolia)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Polkadot / Westend Asset Hub ──────────────
# Public RPC: wss://westend-asset-hub-rpc.polkadot.io
# HTTP RPC:   https://westend-asset-hub-rpc.polkadot.io
WESTEND_ASSET_HUB_RPC_URL=https://westend-asset-hub-rpc.polkadot.io

# Subscan API key for contract verification on Westend Asset Hub
SUBSCAN_API_KEY=YOUR_SUBSCAN_API_KEY

# Hydration (Aave V3 fork parachain) — lending pool on Hydration testnet
# Substrate RPC: wss://rpc.nice.hydration.cloud
HYDRATION_RPC_URL=wss://rpc.nice.hydration.cloud
# The Hydration lending pool contract address (Aave V3-compatible ABI)
HYDRATION_LENDING_POOL=0xTBD_HYDRATION_LENDING_POOL

# ── Acurast (replaces Chainlink CRE) ──────────
# Your Acurast Consumer account (SS58 or H160 address depending on deployment target)
ACURAST_CONSUMER_ADDRESS=0xYOUR_ACURAST_CONSUMER_ADDRESS
# The Acurast Proxy address on Westend Asset Hub — trusted to call onReport()
ACURAST_PROXY_ADDRESS=0xYOUR_ACURAST_PROXY_ADDRESS

# ── Deployed Contract Addresses (fill after forge script) ──
GHOST_TOKEN_ADDRESS=0xTBD
GHOSTFUND_VAULT_ADDRESS=0xTBD
POLKADOT_POLICY_ENGINE_ADDRESS=0xTBD
STEALTH_TRANSFER_ADDRESS=0xTBD
DEPOSIT_EXTRACTOR_ADDRESS=0xTBD

# ── Demo Wallets (generate fresh for Westend testing) ──────
ALICE_PRIVATE_KEY=0xYOUR_ALICE_KEY
ALICE_ADDRESS=0xYOUR_ALICE_ADDRESS
BOB_PRIVATE_KEY=0xYOUR_BOB_KEY
BOB_ADDRESS=0xYOUR_BOB_ADDRESS
CHARLIE_PRIVATE_KEY=0xYOUR_CHARLIE_KEY
CHARLIE_ADDRESS=0xYOUR_CHARLIE_ADDRESS

# The owner address that calls userApprove() — defaults to deployer
VAULT_OWNER=0xYOUR_VAULT_OWNER_ADDRESS

# ── Legacy Sepolia (keep during transition only) ────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
